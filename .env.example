GOOGLE_CLOUD_PROJECT=rapid-stage-506406-t4
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

BIGQUERY_PROJECT=rapid-stage-506406-t4
BIGQUERY_DATASET=iam_data_dev
BIGQUERY_ROWS_PER_TABLE=10

# Local development. In Cloud Run use a PostgreSQL URL for Cloud SQL.
DATABASE_URL=sqlite+pysqlite:///./iam_agent.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE

# Set this to true whenever the Google Chat endpoint is publicly reachable.
VERIFY_GOOGLE_CHAT_TOKEN=false
GOOGLE_CHAT_AUDIENCE=
GOOGLE_CHAT_SERVICE_ACCOUNT=chat@system.gserviceaccount.com

# Browser demo authenticated by Google Identity Services. This is an OAuth
# web-client ID, not a client secret. Gmail users must also be allowlisted below.
ENABLE_WEB_UI=false
WEB_GOOGLE_CLIENT_ID=
WEB_ANALYST_PRINCIPALS=your.personal.account@gmail.com
WEB_APPROVER_PRINCIPALS=
WEB_ADMIN_PRINCIPALS=

# Comma-separated Google Workspace emails. Use different requester and approver users.
CHAT_ANALYST_PRINCIPALS=analyst@yourdomain.com
CHAT_APPROVER_PRINCIPALS=approver@yourdomain.com
CHAT_ADMIN_PRINCIPALS=
CHAT_DEFAULT_SCOPE=/company
