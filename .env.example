GOOGLE_CLOUD_PROJECT=rapid-stage-506406-t4
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

BIGQUERY_PROJECT=rapid-stage-506406-t4
BIGQUERY_DATASET=iam_data_dev

# Hard ceilings applied after Gemini returns a semantic plan and before BigQuery runs.
QUERY_MAX_ROWS=500
QUERY_MAX_BYTES_BILLED=500000000
QUERY_MAX_LOOKBACK_DAYS=90
QUERY_MAX_STEPS=6

# Browser UI authenticated by Google Identity Services. This is an OAuth web
# client ID, not a client secret. Comma-separate multiple allowed accounts.
ENABLE_WEB_UI=false
WEB_GOOGLE_CLIENT_ID=
WEB_ANALYST_PRINCIPALS=your.personal.account@gmail.com

# Optional Google Chat interface. Workspace accounts normally use this path.
VERIFY_GOOGLE_CHAT_TOKEN=false
GOOGLE_CHAT_AUDIENCE=
GOOGLE_CHAT_SERVICE_ACCOUNT=chat@system.gserviceaccount.com
CHAT_ANALYST_PRINCIPALS=analyst@yourdomain.com

# All configured users receive read-only access below this hierarchy path.
QUERY_DEFAULT_SCOPE=/company

# No database URL, Cloud SQL instance, approver, or remediation setting is used.
